<!-- Require the real original framework HIDL manager used in this experiment.
     This does not replace the framework's device requirements or certify them. -->
<compatibility-matrix version="1.0" type="device">
    <hal format="hidl" optional="false">
        <name>android.hidl.manager</name>
        <version>1.2</version>
        <interface>
            <name>IServiceManager</name>
            <instance>default</instance>
        </interface>
    </hal>
</compatibility-matrix>
