  "required_linux_decisions": [
    "Scope original class restart to explicitly managed cohort; preserve flags/enable state and dependencies, no arbitrary host service control",
    "Define critical and reboot_on_failure behavior as explicit Linux-supervisor failure policy; do not silently clear flags or reboot host",
    "Validate Android UID/GID/cgroups/device FDs/task profiles/capabilities and original SELinux transitions before Start",
    "Preserve property action triggers and onrestart order/arguments. Tokens are unexpanded declarations, not completed side effects",
    "Bind policy to approved immutable profile hashes and original parser results; import and override declarations need effective-profile/provenance handling",
    "No CheckAllCommands with runtime builtin map; it invokes handlers"
  ],
  "regressions": [
    "original canonical four-service and one-action declarations",
    "original tokenizer preserves spaces/property template tokens",
    "original ImportParser observed across imported profile",
    "override declaration history separate from original final service UID/args",
    "invalid option causes exit2 and no manifest even when partial original ServiceList exists"
  ],
  "limits": [
    "Audit not complete resolved policy; raw options not substituted for original private/default state",
    "Import targets not restricted by audit; production must constrain/hash them before admission",
    "No native service/process/APK launched by audit; PID0 metadata alone not complete process-tree proof",
    "Programmatic actions and mutable source files outside approved immutable profile set not admitted",
    "GMS/DRM/ARM remain separate unresolved axes"
  ]
