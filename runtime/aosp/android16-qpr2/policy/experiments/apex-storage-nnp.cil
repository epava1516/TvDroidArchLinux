; Original init->vold/apexd transitions already exist in pinned AOSP policy.
; Actual170 enforcing audit1090939/1090942 denies only the extra Linux NNP
; admission gate before exec. Preserve NNP1, original transition/entrypoint
; checks, IDs and caps. Never allow init execute_no_trans on daemon executables.
(allow init vold (process2 (nnp_transition)))
(allow init apexd (process2 (nnp_transition)))

; Selected native cohort: every edge exists in original pinned policy,
; recorded in selected-exec-nnp-review.json. Preserve NNP1, original exec
; transition/entrypoint checks and identities; no execute_no_trans.
; No new Binder/file/device rights or direct system_server entry.
(allow init bpfloader (process2 (nnp_transition)))
(allow init netd (process2 (nnp_transition)))
(allow init hal_graphics_allocator_default (process2 (nnp_transition)))
(allow init hal_graphics_composer_default (process2 (nnp_transition)))
(allow init surfaceflinger (process2 (nnp_transition)))
(allow init bootanim (process2 (nnp_transition)))
(allow init hal_keymint_default (process2 (nnp_transition)))
(allow init hal_gatekeeper_default (process2 (nnp_transition)))
(allow init gatekeeperd (process2 (nnp_transition)))
(allow init keystore (process2 (nnp_transition)))
(allow init lmkd (process2 (nnp_transition)))
(allow init storaged (process2 (nnp_transition)))
(allow init idmap (process2 (nnp_transition)))
(allow init mediaswcodec (process2 (nnp_transition)))
(allow init artd (process2 (nnp_transition)))
(allow init statsd (process2 (nnp_transition)))
(allow init hal_health_default (process2 (nnp_transition)))
(allow init zygote (process2 (nnp_transition)))
(allow init system_suspend (process2 (nnp_transition)))
(allow init installd (process2 (nnp_transition)))

; Original pinned init->logd transition retained; Linux NNP admission only.
(allow init logd (process2 (nnp_transition)))

; Original system-server fork: zygote.te admits dyntransition only through
; system_server_startup; system_server_startup.te then admits system_server.
; The Linux supervisor's irreversible NNP1 adds this second kernel gate.
; Actual policy42 AV denies both NNP edges; preserve NNP1, original UID/caps,
; setcurrent/dyntransition/seapp hooks and the denial of direct init entry.
(allow zygote system_server_startup (process2 (nnp_transition)))
(allow system_server_startup system_server (process2 (nnp_transition)))

; Complete original zygote.te dynamic-transition target set for APK forks.
; Actual45 permits these original dyntransitions but denies the extra NNP1
; gate. Preserve irreversible NNP1 and original UID/GID/caps/seapp checks.
; No additional dyntransition, executable, Binder or file permission added.
(allow zygote appdomain (process2 (nnp_transition)))
(allow zygote webview_zygote (process2 (nnp_transition)))
(allow zygote app_zygote (process2 (nnp_transition)))

; Original init_daemon_domain transitions for the complete native media/crash
; profiles. Linux NNP1 remains irreversible; original exec labels, identities,
; capabilities, Binder/ptrace and file rules remain the authorization gates.
(allow init mediaserver (process2 (nnp_transition)))
(allow init mediaextractor (process2 (nnp_transition)))
(allow init mediametrics (process2 (nnp_transition)))
(allow init tombstoned (process2 (nnp_transition)))
; Original debuggerd_handler.cpp forces in-process fallback under NNP1;
; the crash_dump exec path is not used. Actual249 denies system_server's
; tombstoned_crash socket write. Full original public/te_macros
; crash_dump_fallback(system_server), user-build branch, retains NNP1 and
; ptrace restrictions. FD/append permissions are for original diagnostic
; descriptors, never direct arbitrary file writes or app authorization.
(allow system_server anr_data_file (file (append)))
(allow system_server dumpstate (fd (use)))
(allow system_server incidentd (fd (use)))
(allow system_server dumpstate (fifo_file (append write)))
(allow system_server incidentd (fifo_file (append write)))
(allow system_server system_server (fifo_file (append write)))
(allow system_server tombstoned (unix_stream_socket (connectto)))
(allow system_server tombstoned (fd (use)))
(allow system_server tombstoned_crash_socket (sock_file (write)))
(allow system_server tombstone_data_file (file (append)))
