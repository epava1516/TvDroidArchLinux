; Original derive_classpath uses init_daemon_domain and original system UID.
; Preserve NNP1 as on the already-tested original vold/apexd service edges.
(allow init derive_classpath (process2 (nnp_transition)))
; These admitted original services use Linux's /proc/self aliases. Reuse the
; existing MC1 read-only metadata bridge, not host files or executable bundles.
(typeattributeset archtv_mc1_android (vold apexd derive_classpath linkerconfig))
(allow archtv_mc1_android proc_mounts (lnk_file (read)))
(allow archtv_mc1_android linux.security_t (filesystem (getattr)))
(allow archtv_mc1_android linux.security_t (dir (search)))
(allow archtv_mc1_android linux.security_t (file (getattr)))
; Original shell may read status; the Linux boundary deliberately keeps
; appdomain (including shell) unable to write any host SELinux control.
(allow shell linux.security_t (dir (read open getattr search)))
(allow shell linux.security_t (file (read open getattr map)))
; Trusted Linux observer reads only /proc metadata labelled by these domains.
; No ptrace, memory access, writes or Android capabilities are introduced.
(typeattribute archtv_storage_observed)
(typeattributeset archtv_storage_observed (vold apexd derive_classpath))
(allow linux.init_t archtv_storage_observed (process (getattr)))
(allow linux.init_t archtv_storage_observed (dir (search)))
(allow linux.init_t archtv_storage_observed (file (read open getattr)))
; Global host policy/mode authority remains with Linux, never any Android SID.
(neverallow domain linux.security_t (security (load_policy setenforce setbool setsecparam setcheckreqprot)))
; The trusted Linux verifier reads the actual original derive output; it
; cannot infer classpath correctness from an exit status or a log line.
(allow linux.init_t environ_system_data_file (dir (search)))
(allow linux.init_t environ_system_data_file (file (read open getattr)))
; Original perform_apex_config synchronously execs original linkerconfig
; (builtins.cpp:1180–1187); its original init transition also preserves NNP1.
(allow init linkerconfig (process2 (nnp_transition)))
; Actual173: original SetupMountNamespaces cannot open its own namespace
; FD because Linux owns nsfs globally. Only init gets namespace metadata;
; original setns/capability checks and private /proc view remain required.
(allow init linux.nsfs_t (file (read open getattr)))
; Never let that metadata edge expose control-plane /proc namespace handles.
(neverallow init linux.init_t (dir (search)))
(neverallow init archtv_launcher (dir (search)))
; Actual173: fstat of the Linux-owned persisted /data FD needs only metadata.
(allow linux.init_t system_data_root_file (dir (getattr)))

; Actual174: original early_system_aconfigd_platform_init is blocked at the
; original init_daemon_domain edge by NNP1. Keep that transition and NNP;
; never permit execute_no_trans as a substitute.
(allow init aconfigd (process2 (nnp_transition)))
; Actual174: independent Linux verifier reads its immutable expected manifest
; carried in the vendor image, never substitutes it for original XML/mounts.
(allow linux.init_t vendor_configs_file (file (read open getattr)))

; Actual175: original aconfigd reaches exec with NNP1, then Bionic/Rust
; follows /proc/self. Linux owns the proc alias label; directory/file target
; checks remain separate. Do not expose host namespace handles.
(allow aconfigd linux.proc_t (lnk_file (read)))
; Independent trusted Linux observer traverses original private RO images
; and the producer's APEX mount tree. These are search-only edges, not
; Android privileges, file contents, writes, or synthetic inventory.
(allow linux.init_t vendor_file (dir (search)))
(allow linux.init_t system_file (dir (search)))
(allow linux.init_t apex_mnt_dir (dir (search)))

; Actual176: mainline original RC/init_daemon_domain reaches the NNP gate.
; Its source main.rs calls inherited_fd::init_once before logging; the pinned
; rustutils implementation canonicalizes /proc/self/fd. Preserve both checks
; and NNP, with Linux's proc alias bridge only (no execute_no_trans).
(allow init aconfigd_mainline (process2 (nnp_transition)))
(allow aconfigd_mainline linux.proc_t (lnk_file (read)))
; Actual176 verifier reads original producer XML, not a generated inventory.
(allow linux.init_t apex_info_file (file (read open getattr)))

; Original builtins.cpp init_user0 invokes /system/bin/vdc --wait cryptfs
; init_user0. Pinned AOSP already defines init vdc_exec -> vdc. Preserve NNP1
; at that exact original edge instead of root shell or execute_no_trans.
(allow init vdc (process2 (nnp_transition)))
(allow vdc linux.proc_t (lnk_file (read)))

; Actual179: VDC reaches vold; original FsCrypt.cpp910–915 executes the
; helper and1045 requires its result. Original vold_prepare_subdirs_exec
; transition exists; preserve NNP1 and all original helper checks.
(allow vold vold_prepare_subdirs (process2 (nnp_transition)))
; Actual179 VDC's genuine SELinux/filesystem discovery on the Linux host.
; Read-only metadata; no bundle search, policy controls or host mount rights.
(allow vdc linux.security_t (filesystem (getattr)))
(allow vdc proc_mounts (lnk_file (read)))
(allow vdc proc_filesystems (file (read open getattr)))


; Actual180 ConfigureReadAhead failed at Linux-labelled sysfs ancestors.
; Actual load15 before/after proves original broad sysfs_loop genfs labels
; ALREADY existed, including loop0/1. Do not add redundant file mappings or
; advertise exclusive labels. Private RO sysfs/RW reserved control binds and
; exact pool checks are VFS constraints, not general MAC/remount resistance.
(allow apexd linux.sysfs_t (dir (read open getattr search)))
(allow apexd linux.sysfs_t (lnk_file (read)))
(allow linux.init_t sysfs_loop (file (read open getattr)))
; Actual181 denies original APEX ext4 mount with Linux owning fsuse ext4.
; Original private/apexd.te107 permits labeledfs mount/unmount. Adapt only
; that original daemon/FS identity edge, preserving bdev, mountpoint, SID,
; capability, namespaces and all original neverallow checks.
(allow apexd linux.fs_t (filesystem (mount unmount)))

; Actual189: the Linux device-event bridge cannot traverse sysfs_dm to read
; the real kernel dm/name, dm/uuid and dev values. Read-only discovery keeps
; the existing immutable allowed-name/UUID checks; no Android domain gets
; new rights and no write/mount/relabel/device ioctl is granted here.
(allow linux.init_t sysfs_dm (dir (read open getattr search)))
(allow linux.init_t sysfs_dm (file (read open getattr)))
(allow linux.init_t sysfs_dm (lnk_file (read getattr)))
; Actual188/189 also show host udev/systemd denied traversal of the globally
; AOSP-labeled loop sysfs nodes. Restore read-only Linux discovery; existing
; private RO sysfs and precise RW control binds remain the runtime boundary.
(allow linux.init_t sysfs_loop (dir (read open getattr search)))
(allow linux.init_t sysfs_loop (lnk_file (read getattr)))

; Actual190 and complete devices.py publication lifecycle: trusted Linux
; control-plane bridge creates a real node only after exact manifest-derived
; dm/name + kernel UUID + dev major/minor checks. Apply original file contexts,
; then publish UUID link only after its real control bind succeeds. Android
; domains gain no rights; no block contents read/write, open or ioctl here.
; block_device is the original private /dev/block directory/default node and
; UUID symlink type; dm_device is the original /dev/block/dm-N node label.
(allow linux.init_t block_device (dir (read open getattr search write add_name remove_name)))
(allow linux.init_t block_device (blk_file (create getattr setattr relabelfrom unlink)))
(allow linux.init_t dm_device (blk_file (getattr setattr relabelto unlink)))
(allow linux.init_t block_device (lnk_file (create getattr read relabelfrom relabelto unlink)))
; Actual193 uses real RO kernel indexes; no sysfs-typed tmpfs link
; mutation/association grants are required. Retire the unused18 permits.
; Target of the existing exact read_ahead_kb bind in the private mount ns.
; No new filesystem mount/remount, attribute write or Android permission.
(allow linux.init_t sysfs_dm (file (mounton)))

; Actual198: trusted Linux control-plane bpftool cannot inspect original loader
; object IDs while enforcing (map_read/prog_run denied), so owned cleanup IDs
; were incomplete. Grant only that exact original owner edge, no Android app
; rights and no new map_write/prog_load/capability. Linux names prog_run for
; obtaining/inspecting a program FD; this permission ALSO permits program test
; execution if the host caller has required kernel capabilities. It is not a
; read-only permission. Trusted host control-plane already owns these tests.
(allow linux.init_t bpfloader (bpf (map_read prog_run)))

; Complete the trusted host ownership-inspection path: original198 denies
; bpffs directory search as well as BPF object info. Only metadata/opaque
; read handles; no directory mutation, inode writes or map_write. Combined
; with the exact bpfloader-owner edge above, this lets the existing observer
; record real pinned IDs for cleanup. No Android domain gains permissions.
(allow linux.init_t bpffs_type (dir (read open getattr search)))
(allow linux.init_t bpffs_type (file (read open getattr)))

; Actual202 original netd map_create hits Linux6.18 syscall.c1450..1457:
; unprivileged_bpf_disabled=2 additionally demands CAP_BPF. Original AOSP
; netd.te16 already permits self:bpf map_create; its Linux RC carries BPF.
; Authorize only the corresponding capability of this original daemon.
; This capability supports more than maps; all original bpf object checks
; remain, including no new prog_load/map_write rights. No SYS_ADMIN or app
; grant, and the global Linux sysctl stays2. Neverallow compilation required.
(allow netd self (capability2 (bpf)))
