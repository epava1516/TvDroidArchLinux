(typetransition perfetto linux.tmpfs_t file perfetto_tmpfs)
(typetransition permissioncontroller_app linux.tmpfs_t file appdomain_tmpfs)
(typetransition platform_app linux.tmpfs_t file appdomain_tmpfs)
(typetransition priv_app linux.tmpfs_t file appdomain_tmpfs)
(typetransition radio linux.tmpfs_t file appdomain_tmpfs)
(typetransition rkpdapp linux.tmpfs_t file appdomain_tmpfs)
(typetransition runas_app linux.tmpfs_t file appdomain_tmpfs)
