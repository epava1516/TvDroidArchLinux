(typetransition shell linux.tmpfs_t file appdomain_tmpfs)
(typetransition simpleperf linux.tmpfs_t file appdomain_tmpfs)
(typetransition surfaceflinger linux.tmpfs_t file surfaceflinger_tmpfs)
(typetransition system_app linux.tmpfs_t file appdomain_tmpfs)
(typetransition system_server linux.tmpfs_t file system_server_tmpfs)
(typetransition system_server_startup linux.tmpfs_t file system_server_startup_tmpfs)
(typetransition traced linux.tmpfs_t file traced_tmpfs)
(typetransition traced_probes linux.tmpfs_t file traced_probes_tmpfs)
