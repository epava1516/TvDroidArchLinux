; Original AOSP platform + admitted original vendor tmpfs-file transitions.
; Source SHA256 0db74564bb4efd556f0502d44ed85451d522b92ddffaac1163bf55057119d0f1
; Linux owns fsuse tmpfs; global memfd is not from private mounted Android tmpfs.
; Keep original domain/result type, MLS and per-domain file permissions.
; No file read/write/execute permission is added.
(typetransition adservices linux.tmpfs_t file appdomain_tmpfs)
(typetransition app_zygote linux.tmpfs_t file app_zygote_tmpfs)
(typetransition artd linux.tmpfs_t file artd_tmpfs)
(typetransition audioserver linux.tmpfs_t file audioserver_tmpfs)
(typetransition bluetooth linux.tmpfs_t file appdomain_tmpfs)
(typetransition cameraserver linux.tmpfs_t file cameraserver_tmpfs)
(typetransition crosvm linux.tmpfs_t file crosvm_tmpfs)
(typetransition device_as_webcam linux.tmpfs_t file appdomain_tmpfs)
(typetransition dexopt_chroot_setup linux.tmpfs_t file dexopt_chroot_setup_tmpfs)
(typetransition dumpstate linux.tmpfs_t file dumpstate_tmpfs)
(typetransition ephemeral_app linux.tmpfs_t file appdomain_tmpfs)
(typetransition gmscore_app linux.tmpfs_t file appdomain_tmpfs)
(typetransition heapprofd linux.tmpfs_t file heapprofd_tmpfs)
(typetransition init linux.tmpfs_t file init_tmpfs)
(typetransition isolated_app linux.tmpfs_t file appdomain_tmpfs)
(typetransition isolated_compute_app linux.tmpfs_t file appdomain_tmpfs)
