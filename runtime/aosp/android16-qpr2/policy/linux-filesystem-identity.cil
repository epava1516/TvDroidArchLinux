; Linux owns the global ext4 filesystem SID, including the private persisted
; data bind and original read-only images. Mirror original AOSP domain->fs_type
; getattr and file_type->labeledfs associate, preserving all file/DAC/MLS checks.
; No file contents, mounts or relabel permission is granted here.
(allow domain linux.fs_t (filesystem (getattr)))
(allow file_type linux.fs_t (filesystem (associate)))

; Original common SELinuxFS metadata contract (pinned CIL22468/73/83).
; Linux owns this filesystem's SID and labels. Without the original statfs
; permission libselinux init.c cannot find selinux_mnt and Android enabled.c
; reports disabled. Actual194 vold_prepare_subdirs metadata AVC demonstrates
; this path; a zero helper exit is not restorecon/security acceptance.
; No read/write/administration permission is added; private load/enforce/etc
; leaves remain individually RO, while the real selinuxfs root remains RW as
; required by original verify_selinuxmnt().
(allow domain linux.security_t (filesystem (getattr)))
(allow domain linux.security_t (dir (search)))
(allow domain linux.security_t (file (getattr)))

; Actual197 original map pin denied associate: fs_bpf_tethering -> Linux.bpf_t.
; Original pinned policy18519 grants bpffs_type except fs_bpf association on
; its own fs_bpf filesystem SID. Preserve that complete object set and only
; adapt the Linux-owned filesystem SID; original map/program/pin, directory,
; DAC and capability checks are unchanged. No generic file-type or domain grant.
(typeattribute archtv_original_bpffs_objects)
(typeattributeset archtv_original_bpffs_objects (and (bpffs_type) (not (fs_bpf))))
(allow archtv_original_bpffs_objects linux.bpf_t (filesystem (associate)))
