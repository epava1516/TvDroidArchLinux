; Linux owns the global ext4 filesystem SID, including the private persisted
; data bind and original read-only images. Mirror original AOSP domain->fs_type
; getattr and file_type->labeledfs associate, preserving all file/DAC/MLS checks.
; No file contents, mounts or relabel permission is granted here.
; Whole original fs_type metadata contract, including virtual filesystems.
; Linux calls its corresponding attribute filesystem_type. No contents,
; administration or mount permission is added.
(allow domain linux.filesystem_type (filesystem (getattr)))
(allow domain linux.filesystem_type (dir (getattr)))
(allow file_type linux.fs_t (filesystem (associate)))

; Original common SELinuxFS metadata contract (pinned CIL22468/73/83).
; Linux owns this filesystem's SID and labels. Without the original statfs
; permission libselinux init.c cannot find selinux_mnt and Android enabled.c
; reports disabled. Actual194 vold_prepare_subdirs metadata AVC demonstrates
; this path; a zero helper exit is not restorecon/security acceptance.
; No read/write/administration permission is added; private load/enforce/etc
; leaves remain individually RO, while the real selinuxfs root remains RW as
; required by original verify_selinuxmnt().
; filesystem getattr is covered by the common owner mapping above.
(allow domain linux.security_t (dir (search)))
(allow domain linux.security_t (file (getattr)))

; Actual197 original map pin denied associate: fs_bpf_tethering -> Linux.bpf_t.
; Original pinned policy18519 grants bpffs_type except fs_bpf association,
; AND common27721 grants fs_type self association (fs_bpf is an fs_type).
; Actual199 platform mkdir/root pins exposed that missing reflexive edge.
; Together the original effective contract covers all bpffs_type objects.
; Adapt only filesystem owner SID; original map/program/pin, directory,
; DAC/capability checks remain. No generic file-type/domain mutation grant.
(typeattribute archtv_original_bpffs_objects)
(typeattributeset archtv_original_bpffs_objects (bpffs_type))
(allow archtv_original_bpffs_objects linux.bpf_t (filesystem (associate)))

; Pinned AOSP CIL22478 grants every original domain sysfs directory search.
; Linux owns the real GPU metadata tree as linux.sysfs_t. Actual207 minigbm
; fails traversing its PCI directory. Mirror only that common traversal
; contract, not directory listing, file contents, writes or host relabeling.
(allow domain linux.sysfs_t (dir (search)))

; Complete the same original generic sysfs metadata contract: pinned
; CIL22363/domain.te214 grants domain->sysfs lnk_file read/getattr.
; Actual208 traverses the PCI dir but Linux-labelled device symlink read
; fails. Preserve all regular target-file contents and mutation checks.
(allow domain linux.sysfs_t (lnk_file (read getattr)))
