; Original pinned FUSE contract projected onto Linux's actual global genfs SID.
; Actual250 vold mount fails against linux.fusefs_t; no real volume was usable.
; Exact source file.te167 attributes: fusefs_type, fs_type, mlstrustedobject.
; Keep original appdomain exclusions, ioctl limits and explicit NEVERALLOWs
; (including system_server/surfaceflinger FUSE content denial). Do not grant
; unlabeled access, modify vold or fabricate MediaProvider volume state.
; This owner SID is GLOBAL, not per-mount. The private root/mount/PID namespace
; and absence of host FUSE bindings remain mandatory; broad isolation is not
; accepted until real app/host-boundary negatives pass (R1-MAC remains open).
; Source SHA256: 0db74564bb4efd556f0502d44ed85451d522b92ddffaac1163bf55057119d0f1
(typeattributeset fusefs_type (linux.fusefs_t))
(typeattributeset fs_type (linux.fusefs_t))
(typeattributeset mlstrustedobject (linux.fusefs_t))
(allow adbd linux.fusefs_t (dir (ioctl read write create getattr setattr lock rename open watch watch_reads add_name remove_name reparent search rmdir)))
(allow adbd linux.fusefs_t (file (ioctl read write create getattr setattr lock append map unlink rename open watch watch_reads)))
