+bool IsLinuxPropertyActionMode() { return linux_property_action_mode; }
+
+Result<void> StartLinuxPropertyActions(Epoll* epoll) {
+    if (!epoll || linux_property_action_mode || wake_main_thread_fd >= 0 || PropertyServiceHasStarted()) {
+        return Error() << "Invalid or duplicate Linux property action coordinator";
+    }
+    if (auto result = epoll->Open(); !result.ok()) return result;
+    InstallInitNotifier(epoll);
+    linux_property_action_epoll = epoll;
+    linux_property_action_mode = true;
+    property_triggers_enabled = 1;
+    // Caller supplies explicit actions. Never load Android boot scripts here.
+    return {};
+}
+
+Result<int> PollLinuxPropertyActions(Epoll* epoll, std::optional<std::chrono::milliseconds> timeout) {
+    if (!epoll || epoll != linux_property_action_epoll || !linux_property_action_mode || wake_main_thread_fd < 0) {
+        return Error() << "Linux property action coordinator is not active";
+    }
+    auto& actions = ActionManager::GetInstance();
+    if (actions.HasMoreCommands()) actions.ExecuteOneCommand();
+    if (actions.HasMoreCommands()) timeout = 0ms;
+    return epoll->Wait(timeout);
+}
+
+Result<void> StopLinuxPropertyActions(Epoll* epoll) {
+    if (!epoll || epoll != linux_property_action_epoll || !linux_property_action_mode || wake_main_thread_fd < 0) {
+        return Error() << "Linux property action coordinator is not active";
+    }
+    if (auto result = StopPropertyService(); !result.ok()) return result;
+    if (ActionManager::GetInstance().HasMoreCommands()) {
+        return Error() << "Property actions remain; poll them before completing shutdown";
+    }
+    property_triggers_enabled = 0;
+    if (auto result = epoll->UnregisterHandler(wake_main_thread_fd); !result.ok()) return result;
+    close(wake_main_thread_fd);
+    wake_main_thread_fd = -1;
+    linux_property_action_mode = false;
+    linux_property_action_epoll = nullptr;
+    return {};
+}
