+Result<void> StopPropertyService() {
+    if (!property_service_ever_started || property_service_closed) return {};
+    StopSendingMessages();
+    property_service_stopping.store(true);
+    uint64_t value = 1;
+    for (int fd : {property_system_stop_fd.get(), property_service_stop_fd.get()}) {
