 ::android::status_t StreamAlsa::flush() {
+    if (!mIsInput && mSinks.empty() && mAlsaDeviceProxies.size() == 1) {
+        auto* pcm = mAlsaDeviceProxies[0].get()->pcm;
+        const int stop = pcm_stop(pcm);
+        const int prepare = stop == 0 ? pcm_prepare(pcm) : -1;
+        LOG(INFO) << "LINUX_PCM_FLUSH stop=" << stop << " prepare=" << prepare;
+        return stop == 0 && prepare == 0 ? ::android::OK : ::android::INVALID_OPERATION;
+    }
     return ::android::OK;
