+Result<void> AdmitLinuxLazyInterface(Epoll* epoll, const std::string& name) {
+    if (!epoll || epoll != linux_property_action_epoll || gettid() != linux_property_action_owner || !linux_property_action_mode) {
+        return Error() << "Linux coordinator is not active";
+    }
+    // Caller validates the complete original profile on the serialized owner.
+    // The property worker reads only this immutable admitted name, never ServiceList.
+    if (!ServiceList::GetInstance().FindInterface(name)) {
+        return Error() << "No original service for Linux lazy interface " << name;
+    }
+    auto lock = std::lock_guard{linux_control_lock};
+    if (!linux_lazy_interfaces.insert(name).second) return Error() << "Duplicate admission";
+    return {};
+}
+
+Result<void> RevokeLinuxLazyInterfaces(Epoll* epoll) {
+    if (!epoll || epoll != linux_property_action_epoll || gettid() != linux_property_action_owner || !linux_property_action_mode) {
+        return Error() << "Linux coordinator is not active";
+    }
+    auto lock = std::lock_guard{linux_control_lock};
+    linux_lazy_interfaces.clear();
+    return {};
+}
