graphify-out/graph.json merge=graphify
# Los logs conservan la salida original de las herramientas.
reports/*.log whitespace=-blank-at-eof
# Capturas H6: conservar espacios y finales originales de Android y herramientas.
reports/h6-*/** -whitespace
reports/h6-ffmpeg-install.log -whitespace
# Avisos upstream: preservar exactamente los bytes verificados por SHA-256.
licenses/cargo-supplemental/** -whitespace
reports/a1-art-host/*.stderr -whitespace
reports/a1-counter-headless/*.stderr -whitespace
reports/a2-wayland/** -whitespace
